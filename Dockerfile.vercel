# HanziSearcher on Vercel (Container Images). Only this file is added; no app code changes.
# Base: python:3.12-alpine (~50MB) + hanzi.db (~164MB) keeps the image under the 250MB function limit.
FROM python:3.12-alpine

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# Copy only what the server needs at runtime (keeps .git, docs/screenshots etc. out of the image)
COPY web_server.py ./
COPY searcher ./searcher
COPY server ./server
COPY static ./static
COPY templates ./templates

# Vercel Web Analytics (HTML variant), injected at build time so templates on main stay untouched
# and main -> vercel merges never conflict. Every HTML page the server returns (/, /index.html,
# /chars, /chars.html, /lego, /lego.html) is rendered from templates/*.html, so patching the
# templates covers all of them. The build fails if any template lacks exactly one </head> or the
# snippet doesn't land exactly once. Enable Analytics in the Vercel dashboard first; if it shows a
# different script path, override with a build arg / change the default below.
ARG VERCEL_ANALYTICS_SCRIPT_SRC=/_vercel/insights/script.js
RUN set -e; \
    ls /app/templates/*.html >/dev/null; \
    for f in /app/templates/*.html; do \
      test "$(grep -o '</head>' "$f" | wc -l)" -eq 1 || { echo "ERROR: $f must contain exactly one </head>" >&2; exit 1; }; \
      python -c "import sys; p, src = sys.argv[1:]; s = '<!-- vercel-web-analytics --><script>window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };</script><script defer src=\"%s\"></script>' % src; t = open(p, encoding='utf-8').read(); open(p, 'w', encoding='utf-8').write(t.replace('</head>', s + '\n</head>', 1))" "$f" "$VERCEL_ANALYTICS_SCRIPT_SRC"; \
      test "$(grep -o 'vercel-web-analytics' "$f" | wc -l)" -eq 1 || { echo "ERROR: analytics injection failed for $f" >&2; exit 1; }; \
      echo "analytics injected: $f"; \
    done

# GoatCounter (public stats dashboard at https://stats.jdkba.com). count.js is vendored into
# /app/static at build time (gc.zgo.at is unreachable from mainland China), so the page loads it
# first-party from /static/gc-count.js; hits go straight to the account endpoint (reachable from China).
ARG GOATCOUNTER_ENDPOINT=https://jdkbachar.goatcounter.com/count
RUN set -e; \
    python -c "import urllib.request; urllib.request.urlretrieve('https://gc.zgo.at/count.js', '/app/static/gc-count.js')"; \
    test "$(wc -c < /app/static/gc-count.js)" -gt 2000; \
    for f in /app/templates/*.html; do \
      python -c "import sys; p, ep = sys.argv[1:]; s = '<!-- goatcounter --><script data-goatcounter=\"%s\" async src=\"/static/gc-count.js\"></script>' % ep; t = open(p, encoding='utf-8').read(); open(p, 'w', encoding='utf-8').write(t.replace('</head>', s + '\n</head>', 1))" "$f" "$GOATCOUNTER_ENDPOINT"; \
      test "$(grep -o 'goatcounter -->' "$f" | wc -l)" -eq 1 || { echo "ERROR: goatcounter injection failed for $f" >&2; exit 1; }; \
    done

# 1) Download the ~164MB SQLite DB from GitHub Releases (pinned to v1.0.0) into a read-only location.
# 2) Point ./data at /tmp/hsdata: the app writes uploaded fonts to data/custom_font.ttf, and on
#    Vercel only /tmp may be writable. hanzi.db is symlinked back in at container start (see CMD).
# 3) Precompile bytecode so cold starts don't recompile.
RUN mkdir -p /opt/hanzi \
 && python -c "import urllib.request; urllib.request.urlretrieve('https://github.com/sheilacraig/HanziSearcher/releases/download/v1.0.0/hanzi.db', '/opt/hanzi/hanzi.db')" \
 && test "$(wc -c < /opt/hanzi/hanzi.db)" -gt 100000000 \
 && chmod 644 /opt/hanzi/hanzi.db \
 && ln -s /tmp/hsdata /app/data \
 && python -m compileall -q /app

# Vercel routes traffic to $PORT (default 80). Do NOT set ENV PORT here; if you change the port,
# set PORT in Vercel Project Settings > Environment Variables instead.
CMD ["sh", "-c", "mkdir -p /tmp/hsdata && ln -sf /opt/hanzi/hanzi.db /tmp/hsdata/hanzi.db && exec python web_server.py ${PORT:-80} --host 0.0.0.0"]
